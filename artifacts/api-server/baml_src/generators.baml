// T-25 (2026-08-29): BAML generator config. `version` MUST equal the
// `@boundaryml/baml` version pinned in package.json (and the two native
// binaries pinned beside it) -- the runtime refuses a client generated by a
// different compiler version. Bump all of them together, in one commit.
generator target {
  output_type "typescript"
  output_dir "../src"
  version "0.226.1"
  default_client_mode async
}
